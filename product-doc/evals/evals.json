{
  "schema_version": 1,
  "execution_status": "NOT_RUN",
  "purpose": "人工或agent效果回归用例；不是已执行测试结果",
  "cases": [
    {
      "id": "full-power",
      "prompt": "请从当前配置给启动电压、满功率电压与限流。",
      "must": [
        "定义和使用处均查",
        "共同限制求交",
        "必要条件非保证",
        "输入输出分开"
      ]
    },
    {
      "id": "disabled-feature",
      "prompt": "源码有温度保护宏，但实际配置关闭了。",
      "must": [
        "标关闭而非启用",
        "不把默认宏当活动逻辑",
        "缺编译变体明确限制"
      ]
    },
    {
      "id": "settings-ack",
      "prompt": "串口回复成功是否说明参数已保存？",
      "must": [
        "受理/内存/持久化分开",
        "失败和重试条件",
        "同值不写的处理要查源码"
      ]
    },
    {
      "id": "profiles",
      "prompt": "生成多种电池档案与TC/CC/CV/FC运行说明。",
      "must": [
        "逐档实值表",
        "条件/恢复成对",
        "实际档案数量",
        "未知测量精度不编造"
      ]
    },
    {
      "id": "derived-current",
      "prompt": "代码根据功率估算电流，说明产品限流能力。",
      "must": [
        "估算非独立采样",
        "预算非硬件恒流精度",
        "不发明效率实测"
      ]
    },
    {
      "id": "export-update",
      "prompt": "一个参数变更后更新MD、图、CSV、Word和HTML。",
      "must": [
        "同一来源重新导出",
        "不只改版本号",
        "DOCX逐页检查或NOT_RUN",
        "不自动声称板级验证"
      ]
    }
  ]
}
